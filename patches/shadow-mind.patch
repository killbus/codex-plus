+#[tokio::test]
+#[serial]
+async fn shadow_pause_and_resume_commands_are_visible() {
+    codex_shadow_extension::resume();
+    let (mut chat, mut rx, _op_rx) = make_chatwidget_manual(/*model_override*/ None).await;
+    chat.set_feature_enabled(Feature::Shadow, /*enabled*/ true);
+
+    submit_composer_text(&mut chat, "/shadow pause");
+    let cells = drain_insert_history(&mut rx);
+    assert!(codex_shadow_extension::is_paused());
+    insta::assert_snapshot!(
+        lines_to_single_string(&cells[0]),
+        @"• Shadow minds paused."
+    );
+
+    submit_composer_text(&mut chat, "/shadow resume");
+    let cells = drain_insert_history(&mut rx);
+    assert!(!codex_shadow_extension::is_paused());
+    insta::assert_snapshot!(
+        lines_to_single_string(&cells[0]),
+        @"• Shadow minds resumed."
+    );
+}

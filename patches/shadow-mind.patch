+    pub(crate) fn has_client_input_reservations(&self) -> bool {
+        self.client_input_reservations
+            .load(std::sync::atomic::Ordering::Acquire)
+            & CLIENT_INPUT_RESERVATION_MASK
+            != 0
+    }
+
+    pub(crate) fn reserve_client_input(&self) {
+        let result = self.client_input_reservations.fetch_update(
+            std::sync::atomic::Ordering::AcqRel,
+            std::sync::atomic::Ordering::Acquire,
+            |state| {
+                let reservations = state & CLIENT_INPUT_RESERVATION_MASK;
+                if reservations == CLIENT_INPUT_RESERVATION_MASK {
+                    None
+                } else {
+                    Some(state + 1)
+                }
+            },
+        );
+        assert!(result.is_ok(), "client input reservation overflow");
+    }
+
+    pub(crate) fn release_client_input(&self) {
+        let result = self.client_input_reservations.fetch_update(
+            std::sync::atomic::Ordering::AcqRel,
+            std::sync::atomic::Ordering::Acquire,
+            |state| {
+                let reservations = state & CLIENT_INPUT_RESERVATION_MASK;
+                if reservations == 0 {
+                    None
+                } else {
+                    Some(state - 1)
+                }
+            },
+        );
+        assert!(result.is_ok(), "client input reservation underflow");
+    }

+impl<S> ShadowExtension<S>
+where
+    S: AgentSpawner<StartThreadOptions, Spawned = NewThread, Error = CodexErr>
+        + Send
+        + Sync
+        + 'static,
+{
+    fn clone_for_task(&self) -> ShadowTaskHost<S> {

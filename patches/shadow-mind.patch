+/// Ordinary HTTP 429 responses use the same bounded request backoff as transient 5xx errors.
+#[tokio::test(flavor = "current_thread")]
+async fn responses_http_429_retries_with_local_backoff() -> Result<()> {
+    skip_if_no_network!(Ok(()));

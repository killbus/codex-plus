+struct ClientInputReservation<'a> {
+    session: &'a Session,
+}
+
+impl<'a> ClientInputReservation<'a> {
+    fn enter_for_request(
+        session: &'a Session,
+        request: &TurnInputRequest,
+        mode: &TurnInputMode,
+    ) -> Option<Self> {
+        let reserves_client_input = match mode {
+            TurnInputMode::StartOrSteer | TurnInputMode::Steer { .. } => true,
+            TurnInputMode::StartIfIdle => {
+                matches!(
+                    &request.input,
+                    SubmittedTurnInput::UserInput { content, .. } if !content.is_empty()
+                )
+            }
+        };
+        reserves_client_input.then(|| {
+            session.reserve_client_input();
+            Self { session }
+        })
+    }
+}
+
+impl Drop for ClientInputReservation<'_> {
+    fn drop(&mut self) {
+        self.session.release_client_input();
+    }
+}

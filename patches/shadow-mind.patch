+                vec![user_message("shadow report")],
+            )
+            .await
+    });
+
+    timeout(
+        StdDuration::from_secs(2),
+        automatic_gate.wait_until_reached(),
+    )
+    .await
+    .expect("automatic turn should reach its final admission boundary");
+
+    let user_session = Arc::clone(&sess);
+    let user_input = tokio::spawn(async move {
+        turn_input::handle(
+            &user_session,
+            TurnInputRequest::user_input(vec![UserInput::Text {
+                text: "client input wins admission".to_owned(),
+                text_elements: Vec::new(),
+            }]),
+            TurnInputMode::StartOrSteer,

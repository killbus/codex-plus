+        "status" => Ok(ShadowCommand::Status),
+        "pause" => Ok(ShadowCommand::Pause),
+        "resume" => Ok(ShadowCommand::Resume),
+        _ => Err("Usage: /shadow [list|status|pause|resume]"),
+    }
+}

+    /// Keep automatic continuation bounded across repeated transient failures.
+    pub(crate) fn allow_transient_continuation(&self) -> bool {
+        const MAX_CONSECUTIVE_TRANSIENT_FAILURES: u32 = 3;
+        self.inner

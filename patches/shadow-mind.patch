+        )
+        .await
+        .expect("client input should be valid")
+    });
+    timeout(StdDuration::from_secs(2), client_gate.wait_until_reached())
+        .await
+        .expect("client input should register before automatic admission");
+
+    automatic_gate.release();
+    let idle_error = timeout(StdDuration::from_secs(2), idle_start)
+        .await
+        .expect("automatic admission should finish after the gate opens")
+        .expect("automatic admission must not panic")
+        .expect_err("registered client input must win automatic admission");
+    assert_eq!(TryStartTurnIfIdleRejectionReason::Busy, idle_error.reason());
+
+    while let Ok(event) = rx.try_recv() {
+        match event.msg {
+            EventMsg::TurnStarted(_) => {
+                panic!("rejected Shadow admission emitted turnStarted")
+            }
+            EventMsg::ItemStarted(ItemStartedEvent { item, .. })
+            | EventMsg::ItemCompleted(ItemCompletedEvent { item, .. })
+                if shadow_report_turn_item_matches(&item, &display_item) =>
+            {
+                panic!("rejected Shadow admission emitted item lifecycle")
+            }
+            _ => {}
+        }
+    }
+
+    client_gate.release();
+    let submission = timeout(StdDuration::from_secs(2), user_input)
+        .await
+        .expect("client input handler should finish after the gate opens")
+        .expect("client input handler should not panic");
+    assert_eq!(
+        submission,
+        TurnInputSubmission::Started {
+            turn_id: "admission-winning-user-turn".to_owned(),
+        }
+    );
+
+    let active_turn = sess
+        .active_turn
+        .lock()
+        .await
+        .as_ref()
+        .and_then(|active_turn| active_turn.task.as_ref())
+        .map(|task| {
+            (
+                task.turn_context.sub_id.clone(),
+                task.turn_context.automatic_turn_origin.clone(),
+            )
+        });
+    let active_or_completed_turn = match active_turn {
+        Some(active_turn) => active_turn,
+        None => {
+            let terminal = recv_terminal_event(&rx, TerminalEventKind::TurnComplete).await;
+            assert_eq!(terminal.id, "admission-winning-user-turn");
+            sess.last_completed_turn

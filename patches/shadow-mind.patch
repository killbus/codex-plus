+async fn client_input_registered_before_automatic_claim_rejects_shadow_without_lifecycle() {
+    let (sess, _tc, rx) = make_session_and_context_with_rx().await;
+    let automatic_gate = AutomaticTurnAdmissionTestGate::default();
+    sess.install_automatic_turn_admission_test_gate(automatic_gate.clone());
